[user]
	# Set your own identity before committing from this machine.
	# Left generic on purpose — a real name/email here is an identity leak.
	name = anon
	email = anon@localhost
[init]
	defaultBranch = main
[pull]
	rebase = false
[core]
	editor = nvim
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
	syntax-theme = ansi
[merge]
	conflictstyle = diff3
[diff]
	colorMoved = default
[alias]
	st = status -sb
	co = checkout
	br = branch
	lg = log --graph --oneline --decorate --all
	last = log -1 HEAD --stat
	unstage = reset HEAD --
[color]
	ui = auto
