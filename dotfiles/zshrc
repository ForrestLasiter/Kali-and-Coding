# ~/.zshrc — Kali T490s (provisioned by kali-t490s/provision.sh)

# --- oh-my-zsh ---------------------------------------------------------------
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""            # empty: starship (below) draws the prompt instead
plugins=(git docker sudo fzf zsh-autosuggestions zsh-syntax-highlighting)
[[ -s "$ZSH/oh-my-zsh.sh" ]] && source "$ZSH/oh-my-zsh.sh"

# --- PATH --------------------------------------------------------------------
export BUN_INSTALL="$HOME/.bun"
export PATH="$HOME/.local/bin:$HOME/go/bin:/usr/local/go/bin:$HOME/.bun/bin:$HOME/.atuin/bin:$HOME/.cargo/bin:$PATH"

# nvm
export NVM_DIR="$HOME/.nvm"
[[ -s "$NVM_DIR/nvm.sh" ]] && source "$NVM_DIR/nvm.sh"

# rust/cargo
[[ -s "$HOME/.cargo/env" ]] && source "$HOME/.cargo/env"

# --- modern CLI aliases (Debian names batcat/fdfind; symlinks also created) --
command -v batcat >/dev/null && alias cat='batcat --style=plain --paging=never'
command -v eza   >/dev/null && alias ls='eza --group-directories-first' \
                             && alias ll='eza -lah --group-directories-first --git' \
                             && alias lt='eza --tree --level=2'
command -v fdfind >/dev/null && alias fd='fdfind'
alias grep='grep --color=auto'
alias ..='cd ..'
alias ...='cd ../..'
alias please='sudo $(fc -ln -1)'   # rerun last command with sudo
alias ports='sudo ss -tulpn'
alias myip='curl -s https://ifconfig.me; echo'
alias ff='fzf --preview "batcat --color=always {} 2>/dev/null || cat {}"'

# quick recon helpers (only if the tools installed via module 30)
alias sub='subfinder -silent'
alias probe='httpx -silent'

# --- history -----------------------------------------------------------------
HISTSIZE=50000
SAVEHIST=50000
HISTFILE="$HOME/.zsh_history"
setopt HIST_IGNORE_ALL_DUPS SHARE_HISTORY INC_APPEND_HISTORY HIST_REDUCE_BLANKS

# --- fzf keybindings ---------------------------------------------------------
[[ -f /usr/share/doc/fzf/examples/key-bindings.zsh ]] && \
  source /usr/share/doc/fzf/examples/key-bindings.zsh
[[ -f /usr/share/doc/fzf/examples/completion.zsh ]] && \
  source /usr/share/doc/fzf/examples/completion.zsh

# --- direnv ------------------------------------------------------------------
command -v direnv >/dev/null && eval "$(direnv hook zsh)"

# --- zoxide (smart cd: use `z <dir>`) ---------------------------------------
command -v zoxide >/dev/null && eval "$(zoxide init zsh)"

# --- atuin (magic shell history; rebinds Ctrl-R and Up) ---------------------
# Loaded after fzf so atuin owns Ctrl-R. Comment out to fall back to fzf/zsh.
command -v atuin >/dev/null && eval "$(atuin init zsh)"

# --- bun completions ---------------------------------------------------------
[[ -s "$HOME/.bun/_bun" ]] && source "$HOME/.bun/_bun"

# --- starship prompt (must be last) -----------------------------------------
command -v starship >/dev/null && eval "$(starship init zsh)"
